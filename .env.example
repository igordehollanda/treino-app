# Projeto Supabase DEDICADO ao app de treinos: "APP - TREINOS".
# NAO usar o projeto do CRM do escritorio (auxilio-acidente).
#
# Onde achar: Supabase > Project Settings > API
#   VITE_SUPABASE_URL      = Project URL
#   VITE_SUPABASE_ANON_KEY = chave "anon public" (ou "publishable")
#
# NUNCA use a chave service_role / secret aqui: ela ignora toda a RLS.
#
# Passo a passo completo: supabase/SETUP.md
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-publishable
